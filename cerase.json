{
  "schema_version": 2,
  "namespace": "reale.errante",
  "name": "linkedin",
  "type": "connector",
  "display_name": "LinkedIn - Personal use",
  "description": "LinkedIn connector built on stickerdaniel/linkedin-mcp-server. Each person signs in to their own LinkedIn account from the console; LinkedIn's terms may restrict automation.",
  "license": "Apache-2.0",
  "tags": [
    "linkedin",
    "social",
    "browser"
  ],
  "install": {
    "image": "ghcr.io/bartolomeo-roberti/linkedin-mcp@sha256:516d145bcddb9a9bec0222528b9e2b888731f33e73ea868a48a802513b70b1f8",
    "state": {
      "path": "/home/pwuser/.linkedin-mcp",
      "max_mb": 200
    },
    "memory_mb": 2048
  },
  "hosts": [
    "linkedin.com",
    "*.linkedin.com",
    "*.licdn.com"
  ],
  "auth": {
    "kind": "browser",
    "credential_scope": "user",
    "login": {
      "args": [
        "--login",
        "--login-viewer"
      ],
      "port": 6080
    }
  },
  "tool_side_effects": {
    "default": "workspace_write",
    "read_only": [
      "get_person_profile",
      "search_people",
      "get_sidebar_profiles",
      "get_my_profile",
      "get_company_profile",
      "get_company_posts",
      "search_companies",
      "get_company_employees",
      "get_job_details",
      "get_job_apply_url",
      "search_jobs",
      "get_saved_jobs",
      "get_inbox",
      "get_conversation",
      "search_conversations",
      "get_feed",
      "search_posts",
      "get_session_status"
    ]
  }
}
